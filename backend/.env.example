# Copy this file to backend/.env for local development.
LULLABYTE_ENVIRONMENT=development
LULLABYTE_DEBUG=false
LULLABYTE_LOG_LEVEL=INFO
# PostgreSQL is required for development/staging/production. Keep credentials
# out of source control. Tests override this with an in-memory SQLite URL.
# LULLABYTE_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/lullabyte
# Firebase Admin credentials are required for protected API routes.
# LULLABYTE_FIREBASE_SERVICE_ACCOUNT_JSON=C:\path\to\service-account.json
# LULLABYTE_FIREBASE_PROJECT_ID=your-firebase-project-id
# Pydantic accepts a JSON array for list-valued environment settings.
LULLABYTE_CORS_ALLOWED_ORIGINS=["http://localhost","http://127.0.0.1"]
